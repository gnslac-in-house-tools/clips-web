#!/usr/bin/env bash
# Rechaza commits en main, medios pesados y secretos. Activado con: git config core.hooksPath .githooks
set -euo pipefail
fail=0
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "✗ El trabajo del video va en la rama feat/video, no en $branch (git switch feat/video)"; fail=1
fi
while IFS= read -r f; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f")
  if [ "$size" -gt 5242880 ]; then echo "✗ $f pesa más de 5 MB"; fail=1; fi
  case "$f" in .env|*.env|.env.*) echo "✗ $f no se versiona (el único .env vive en 01. Videos)"; fail=1 ;; esac
done < <(git diff --cached --name-only --diff-filter=AM)
if git diff --cached -U0 | grep -E '^\+' | grep -qE 'sk-ant-[A-Za-z0-9_-]{10,}|sk_[a-f0-9]{40,}'; then
  echo "✗ El diff contiene algo con forma de API key"; fail=1
fi
exit $fail
